{
  "name": "shopping_list_mern",
  "version": "1.0.0",
  "description": "Shopping list built with mern stack",
  "license": "MIT",
  "author": "Anushka",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
