    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client "
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "concurrently": "^10.0.4",
    "express": "^5.2.1",
    "mongoose": "^9.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
